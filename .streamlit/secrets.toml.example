# Copy these keys into Streamlit Cloud: App settings → Secrets
# Do NOT commit real values to git.
#
# Free deploy guide (Railway expired): DEPLOY-STEPS-FREE.md

# ── Step 1: Expose Ollama (pick one) ─────────────────────────────────────────
#   Free / easiest: local Ollama + ngrok or Cloudflare Tunnel
#     https://github.com/iman-coll/OllamaModel-of-Iman-For-Chatbot/blob/main/DEPLOY-STEPS-FREE.md
#   Railway (if you have credits): deploy/ollama-server/README.md
#
# ── Step 2: Paste your PUBLIC Ollama URL below (required on Streamlit Cloud) ─
#   Examples:
#     https://iman-ollama.ngrok-free.app          (ngrok static domain)
#     https://ollama.yourdomain.com               (Cloudflare Tunnel)
#     https://your-service.onrender.com           (Render)
#   Do NOT use localhost or 127.0.0.1 — they only work on your own PC.
OLLAMA_BASE_URL = "https://your-public-ollama-url"

# ── Step 3: Reboot the Streamlit app after saving secrets ────────────────────

# Optional LangSmith tracing
LANGCHAIN_API_KEY = "your_langsmith_api_key_optional"
