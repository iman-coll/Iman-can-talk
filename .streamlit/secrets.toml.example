# Copy these keys into Streamlit Cloud: App settings → Secrets
# Do NOT commit real values to git.
#
# Full cloud setup guide: deploy/ollama-server/README.md

# ── Step 1: Deploy Ollama to Railway ─────────────────────────────────────────
#   https://github.com/iman-coll/OllamaModel-of-Iman-For-Chatbot/blob/main/deploy/ollama-server/README.md
#
# ── Step 2: Paste your Railway public URL below (required on Streamlit Cloud) ─
#   Example: https://iman-ollama-production.up.railway.app
#   Do NOT use localhost or 127.0.0.1 — they only work on your own PC.
OLLAMA_BASE_URL = "https://your-railway-app.up.railway.app"

# ── Step 3: Reboot the Streamlit app after saving secrets ────────────────────

# Optional LangSmith tracing
LANGCHAIN_API_KEY = "your_langsmith_api_key_optional"
