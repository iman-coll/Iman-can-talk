# Copy these keys into Streamlit Cloud: App settings → Secrets
# Do NOT commit real values to git.

# Required on Streamlit Cloud — localhost/127.0.0.1 will NOT work there.
# Point to a remote Ollama server reachable from the internet (HTTPS recommended).
OLLAMA_BASE_URL = "https://your-remote-ollama-server:11434"

# Optional LangSmith tracing
LANGCHAIN_API_KEY = "your_langsmith_api_key_optional"
