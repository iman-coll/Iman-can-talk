# Paste these keys into Streamlit Cloud: App settings → Secrets
# Do NOT commit real values to git.
#
# Deploy guide: STREAMLIT-DEPLOY.md
# Free Ollama (Cloudflare tunnel): DEPLOY-STEPS-FREE.md

# ── Required on Streamlit Cloud ──────────────────────────────────────────────
# Public HTTPS URL where Ollama is reachable (not localhost).
#
# Free example (Cloudflare quick tunnel):
#   OLLAMA_BASE_URL = "https://random-words.trycloudflare.com"
#
# Test in browser: https://your-url/api/tags
OLLAMA_BASE_URL = "https://your-public-ollama-url"

# ── After saving, reboot the app (Manage app → Reboot) ───────────────────────

# Optional LangSmith tracing
# LANGCHAIN_API_KEY = "your_langsmith_api_key"
